# persianPerch - never commit caches, local secrets or test output.
.cache/
*.env.local
secrets.env.local
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
screenshots/
/data/
# Project skills for Claude Code (installed on roastery, see AGENTS.md 3.1). Third-party
# texts whose licences aren't ours to redistribute, and this repo is public.
.claude/skills/
.claude/settings.local.json
# Output of the Claude desktop app's browser tool, never project content.
.playwright-mcp/
dist/
# Anything shaped like a credential stays out, whatever its name (public-repo review, 2026-10-14). secrets.env is
# tracked on purpose (keys only, test S5); tests/fixtures/secrets.fake.env is tracked (fake values).
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
*.kdbx
rclone.conf

# secrets.env - every setting persianPerch (perch) and kitten need from the fleet.
#
# THIS FILE HOLDS NO VALUES AND NEVER WILL. The repo is public.
# Test S5 fails the build if any KEY= line below gets a value.
#
# What it is: the specification for the files M6 prepares in integration/:
#   stacks/cellar/persian-perch/secrets.conf   (perch, on cellar)
#   the kitten section of each node's settings (roastery: its setup-secrets.ps1)
# Their real values are entered ON THE NODE by the fleet's own ./setup-secrets.sh,
# which writes <app>/secrets.env.local there (gitignored, never read by agents).
# Format of the verbs in [brackets]: stacks/README.md -> secrets.conf
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/README.md
#
# Rules for everyone (AGENTS.md section 2.3):
#   - never paste a value into a chat, a commit, a log or this file;
#   - run the "get it" commands in your own terminal and paste into setup-secrets' prompt;
#   - ${KEY} references are resolved on the node from stacks/fleet.env, the node's
#     .env.local or the app's secrets.env.local - never copied here:
#     https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/fleet.env
#
# Legend per key:  [verb]  secret? - source - how to get it (where the step runs)

# ---------------------------------------------------------------------------
# perch core (not secret; defaults, listed so the inventory is complete)
# ---------------------------------------------------------------------------
# [value /opt/purrbrews]  not secret - the node's repo checkout, mounted read-only
PERCH_REPO_DIR=
# [value /data/scentTrail.db]  not secret
PERCH_TRAIL_DB=
# [value 90]  not secret - days of events
PERCH_TRAIL_DAYS=
# [value 400]  not secret - days of daily rollups (plan C10)
PERCH_ROLLUP_DAYS=
# [value ${TZ}]  not secret - TZ from stacks/fleet.env (plan C10)
PERCH_TZ=

# ---------------------------------------------------------------------------
# purr - Komodo Core read API (cellar, same Docker network)
# ---------------------------------------------------------------------------
# [value http://komodo-core:9120]  not secret - perch joins cellar_net (plan C6)
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/cellar/komodo/docker-compose.yml
PERCH_PURR_URL=
# [prompt]  SECRET - a Komodo API key of a non-admin service user with Read on all
#   servers and stacks. Get it: Komodo UI (https://komodo.${DOMAIN}) as barista ->
#   Settings -> Users -> new service user "perch" -> permissions: Read on every server
#   and stack -> API Keys -> create -> paste key and secret into setup-secrets on cellar.
PERCH_PURR_KEY=
# [prompt]  SECRET - the secret shown with PERCH_PURR_KEY (shown once)
PERCH_PURR_SECRET=
# [value 30s]  not secret
PERCH_PURR_EVERY=

# ---------------------------------------------------------------------------
# glare - Gatus on sieve (plan Q12 = A)
# ---------------------------------------------------------------------------
# [value https://gatus-api.${DOMAIN}]  not secret - new router with forward-auth-basic
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/sieve/traefik/dynamic/sieve.yml
PERCH_GLARE_URL=
# [value perch-svc]  not secret - LLDAP service account, member of perch_api_group only
PERCH_GLARE_USER=
# [prompt]  SECRET - that account's password. Get it (in your terminal, on any node):
#     openssl rand -base64 32
#   then set it on perch-svc in LLDAP's web UI on percolator:
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/percolator/lldap/README.md
#   and paste the same value into setup-secrets on cellar.
PERCH_GLARE_PASSWORD=

# ---------------------------------------------------------------------------
# disks - Scrutiny hub (cellar, same Docker network; no credential)
# ---------------------------------------------------------------------------
# [value http://scrutiny:8080]  not secret (plan C6)
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/cellar/scrutiny/docker-compose.yml
PERCH_DISKS_URL=

# ---------------------------------------------------------------------------
# whiskers - Home Assistant WebSocket on mochaPot (plan Q14 = yes)
# ---------------------------------------------------------------------------
# [value ws://${MOCHAPOT_LAN_IP}:8123/api/websocket]  not secret
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/mochaPot/homeassistant/docker-compose.yml
PERCH_WHISKERS_URL=
# [prompt]  SECRET - long-lived token of a NON-admin HA user "perch". Get it: HA as an
#   admin -> Settings -> People -> Users -> add "perch" (Administrator off) ->
#   log in as perch -> Profile -> Security -> Long-lived access tokens -> Create.
PERCH_WHISKERS_TOKEN=
# [value /config/whiskers.yml]  not secret - entity allow-list and severity map
PERCH_WHISKERS_ENTITIES=

# ---------------------------------------------------------------------------
# binocs - far away (plan C7, C8)
# ---------------------------------------------------------------------------
# tunnel: read from Gatus's tunnel check; no setting.
# [value http://${GRINDER_LAN_IP}:8765]  not secret
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/grinder/speedtest-tracker/docker-compose.yml
PERCH_BINOCS_SPEEDTEST_URL=
# [prompt]  SECRET - speedtest-tracker API token, read-only. Get it: speedtest-tracker UI
#   on grinder -> API Tokens -> create with read ability only.
PERCH_BINOCS_SPEEDTEST_TOKEN=
# [value 7d]  not secret - how often to check upstream image releases
PERCH_BINOCS_RELEASES_EVERY=

# ---------------------------------------------------------------------------
# groom - backups (plan A10)
# ---------------------------------------------------------------------------
# [value /var/lib/purrbrews/groom]  not secret - cellar's own records, mounted read-only
PERCH_GROOM_DIR=

# ---------------------------------------------------------------------------
# kitten push tokens - one per node, roastery included (plan Q9 = B, A5)
# Generated on cellar; each node's kitten gets its own copy (see kitten section).
# Replaces dev plan's PERCH_KITTEN_TOKENS pairs, so the fleet's verbs can make them.
# ---------------------------------------------------------------------------
# [hex 64]  SECRET - generated by setup-secrets on cellar
PERCH_KITTEN_TOKEN_SIEVE=
# [hex 64]  SECRET
PERCH_KITTEN_TOKEN_PERCOLATOR=
# [hex 64]  SECRET
PERCH_KITTEN_TOKEN_CELLAR=
# [hex 64]  SECRET
PERCH_KITTEN_TOKEN_MOCHAPOT=
# [hex 64]  SECRET
PERCH_KITTEN_TOKEN_GRINDER=
# [hex 64]  SECRET
PERCH_KITTEN_TOKEN_ROASTERY=

# ---------------------------------------------------------------------------
# meow - ntfy on sieve (plan C14, Q10 = B, Q11 = B)
# ---------------------------------------------------------------------------
# [value https://ntfy.${DOMAIN}/purrbrews-alerts]  not secret - topic from ntfy's secrets.conf
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/sieve/ntfy/secrets.conf
PERCH_MEOW_NTFY_URL=
# [prompt]  SECRET - perch's own ntfy token (tk_ + 29 chars). Get it, on sieve:
#     printf 'tk_%s\n' "$(openssl rand -hex 15 | cut -c1-29)"
#   Add it on sieve in stacks/sieve/ntfy/secrets.env.local (not in the repo):
#     NTFY_EXTRA_USERS   perch:<bcrypt hash>:user   (hash: sudo docker exec -it ntfy ntfy user hash)
#     NTFY_EXTRA_ACCESS  perch:purrbrews-alerts:wo
#     NTFY_EXTRA_TOKENS  perch:<the token>:perch
#   then ./setup-secrets.sh and ./compose.sh ntfy up -d on sieve; paste the token on cellar.
PERCH_MEOW_NTFY_TOKEN=
# [value 23:00-07:00]  not secret - hiss ignores quiet hours
PERCH_MEOW_QUIET=
# [prompt]  SECRET - the public ntfy.sh critical topic URL Gatus already uses.
#   Get it: on sieve, the NTFY_CRITICAL_TOPIC line of
#   stacks/sieve/gatus/secrets.env.local (read it in your terminal; don't paste it here).
PERCH_MEOW_CRITICAL_URL=
# [hex 64]  SECRET - signs the one-time acknowledge links on pushes (plan Q8 = B, A11);
#   generated by setup-secrets on cellar, never typed anywhere
PERCH_ACK_SECRET=

# ---------------------------------------------------------------------------
# nineLives - outside heartbeat
# ---------------------------------------------------------------------------
# [prompt]  SECRET - healthchecks.io ping URL. Get it: the same account as sieve's check
#   (https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/sieve/gatus/README.md)
#   -> Add Check "perch", period 5 min, grace 10 min -> copy https://hc-ping.com/<uuid>
PERCH_NINELIVES_URL=

# ---------------------------------------------------------------------------
# kitten - on each node (sieve, percolator, cellar, mochaPot, grinder, roastery)
# On roastery these go through its own setup-secrets.ps1 (plan A5):
#   https://github.com/purrMonster/purrbrews-containers/blob/main/stacks/roastery/setup-secrets.ps1
# ---------------------------------------------------------------------------
# [value https://perch.${DOMAIN}/api/kitten]  not secret - the IP-allow-listed router (plan C1)
KITTEN_PERCH_URL=
# [prompt]  SECRET - paste PERCH_KITTEN_TOKEN_<THIS NODE> from cellar:
#   stacks/cellar/persian-perch/secrets.env.local (read it in your terminal on cellar)
KITTEN_TOKEN=
# [value ...]  not secret - per node, from design plan section 4.4 with plan C2;
#   roastery: C:\purrbrews\restic\snapshots (plan A5)
KITTEN_POUNCE_PATHS=
# [value /var/lib/purrbrews/groom]  not secret
KITTEN_GROOM_DIR=
# [value /var/lib/purrbrews]  not secret - where kitten looks for *.ok stamp files (drive-sync.ok);
#   leave empty on roastery (Windows has none) (M2)
KITTEN_STATE_DIR=
# [value <this node's folder in stacks/>]  not secret - sieve, percolator, cellar, mochaPot, grinder or
#   roastery, spelled as the folder is (mochaPot, not mochapot): it must match the token's node (M2)
KITTEN_NODE=
